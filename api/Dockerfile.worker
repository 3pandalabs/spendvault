# spendvault-worker: Temporal worker for processDocumentWorkflow (task queue
# `spendvault`) plus the hourly insights sweep. Same source tree as the API,
# separate Coolify resource, no HTTP port. Needs the same env as the API
# (DATABASE_URL, JWT_SECRET, DATA_KEY, ANTHROPIC_*, MAILER_*/SMTP_*, WHATSAPP_*) plus TEMPORAL_*.
#
# NOT alpine (unlike Dockerfile): @temporalio/core-bridge is a glibc-linked
# native binary and fails on musl with ERR_DLOPEN_FAILED (RentVault, found the
# hard way). bookworm-slim is glibc and still small.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist

RUN groupadd --system spendvault && useradd --system --gid spendvault spendvault
USER spendvault

CMD ["node", "dist/temporal/worker.js"]
