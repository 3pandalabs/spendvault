# SpendVault API + worker. Copy to .env for local dev. NEVER commit real values.

# Postgres. Prod: `spendvault` database on the shared 3pandalabs-postgres, as the
# `spendvault_app` role (owns the database). Local: docker-compose.dev.yml (port 5436).
DATABASE_URL=postgres://spendvault:spendvault@localhost:5436/spendvault
# Do NOT set MIGRATION_DATABASE_URL (no role split; 42501 gotcha).

PORT=8080
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32 — encrypts saved PDF passwords + raw documents. Back it up.
DATA_KEY=

WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=

# Forwarding addresses are INBOUND_MAILBOX+<token>@INBOUND_DOMAIN (one Email Routing rule, plus tags)
INBOUND_MAILBOX=vault
INBOUND_DOMAIN=in.spendvault.3pandalabs.com
# Shared with web + inbound Workers (X-Internal-Secret). openssl rand -hex 32
INTERNAL_SHARED_SECRET=

# Claude extraction/categorization. Blank → rules-only parsing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# WhatsApp Cloud API (Meta). Blank → WhatsApp disabled.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# E.164 number shown to users, e.g. +9198xxxxxxxx
WHATSAPP_DISPLAY_NUMBER=

# true → parse documents inside the API process (local dev without Temporal)
PROCESS_INLINE=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=spendvault

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAILER_URL=https://mailer.3pandalabs.com
MAILER_TOKEN=
EMAIL_FROM_NAME=SpendVault
# "SpendVault New user" alert on each sign-up; blank = 3pandas@3pandalabs.com, "off" disables
NEW_USER_ALERT_EMAIL=

METRICS_TOKEN=

# ---- SpendVault Plus (lib/plan.ts, ROUTES.md "SpendVault Plus") ----
# off (default) = everyone is effectively Plus, nothing changes. on = free/Plus split applies.
BILLING=off
# Stripe TEST mode keys only (sk_test_/rk_test_); live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
# Signing secret of the /webhooks/stripe endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Recurring price ids (price_...). Suggested: US $3/month, $29/year; India ₹79/month, ₹599/year.
# The display amounts in lib/plan.ts PLUS_PRICES must match these prices.
STRIPE_PRICE_USD_MONTH=
STRIPE_PRICE_USD_YEAR=
STRIPE_PRICE_INR_MONTH=
STRIPE_PRICE_INR_YEAR=
