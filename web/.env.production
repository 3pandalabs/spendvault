# Committed on purpose, and load-bearing (same as BorrowVault's web/.env.production).
#
# NEXT_PUBLIC_* variables are INLINED BY NEXT.JS AT BUILD TIME, not read at
# runtime. Putting them only in wrangler.jsonc `vars` is not enough for anything
# the browser executes. These values are public by definition. Nothing secret
# belongs here.
NEXT_PUBLIC_API_URL=https://api.spendvault.3pandalabs.com
NEXT_PUBLIC_SITE_URL=https://spendvault.3pandalabs.com
